# Verified to work with Newsboat 2.36.

DB=~/.newsboat/cache.db
LOGFILE=~/.newsboat/logs/newsboat-$(date +"%Y%m%d%H%M").log

newsboat -l 4 -d $LOGFILE -x reload
ids=$(sqlite3 $DB "select id from rss_item where unread = 1")
if [[ $ids != "" ]]
then
    for id in $ids
    do
        title=$(sqlite3 $DB "select title from rss_item where id = $id")
        url=$(sqlite3 $DB "select url from rss_item where id = $id")
        domain=$(echo $url | awk -F[/:] '{print $4}')
        author=$(sqlite3 $DB "select author from rss_item where id = $id")
        content=$(sqlite3 $DB "select content from rss_item where id = $id")
        tmpfile=/var/tmp/newsboat_email.$id.$$
        trap '/bin/rm -f $tmpfile; exit 1' 1 2 15
        {
            echo "$url"
            echo
            echo "$content" | pandoc -f html -t plain
            echo
        } > $tmpfile
        mutt -s "New news from $domain: $title ($author)" $USER < $tmpfile
        rm -f $tmpfile
        # Now mark this item as unread:
        sqlite3 $DB "update rss_item set unread = 0 where id = $id"
    done
fi

grep -q "ERROR" $LOGFILE && mutt -s "There were errors while running newsboat" $USER < $LOGFILE
